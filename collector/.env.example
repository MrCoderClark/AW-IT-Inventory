# Collector secrets — copy to .env (gitignored) and fill in the local-admin
# passwords referenced by config.yaml profiles.

PW_WIN10_INFOTECH=
PW_WG_INTECH=
PW_AD_INFOTECH=

# Service-account credentials for `scan --ingest` (from aw-auth's
# `create_service_account`). Only needed when ingesting.
OPUS_CLIENT_ID=
OPUS_CLIENT_SECRET=
