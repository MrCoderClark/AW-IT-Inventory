# aw-auth environment (copy to .env for local overrides)

# Generate a strong key for anything but throwaway dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use the dev SQLite file. For Postgres:
# DATABASE_URL=postgres://opus:opus@localhost:5432/authdb

# Origins allowed to call the API (the OPUS web app):
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

DB_SSL_REQUIRE=False
