# aw-auth environment (copy to .env for local overrides)

# Generate a strong key for anything but throwaway dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use the dev SQLite file. For Postgres:
# DATABASE_URL=postgres://opus:opus@localhost:5432/authdb

# Origins allowed to call the API (the OPUS web app):
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# RS256 signing. Run `manage.py generate_keys` to create these; when both files
# exist the service signs with RS256 and publishes /.well-known/jwks.json.
# AUTH_ISSUER is the `iss` claim + OIDC discovery issuer (public URL of aw-auth).
AUTH_ISSUER=http://127.0.0.1:8000
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem

DB_SSL_REQUIRE=False
