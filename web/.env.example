# Copy to web/.env and fill in. Never commit web/.env.

DATABASE_URL=postgres://user:pass@192.168.70.10:5432/aw_it_inventory_web
# DB_SSL_REQUIRE=true

AUTH_API_URL=http://127.0.0.1:8000
# AUTH_ISSUER=http://127.0.0.1:8000

# Service account used by web for notify / internal calls (aw-auth)
OPUS_WEB_CLIENT_ID=
OPUS_WEB_CLIENT_SECRET=

# Optional absolute origin for ticket email deep links (e.g. https://inventory.example)
# WEB_PUBLIC_URL=http://localhost:3000

# Optional object storage (asset images / software packages)
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=

# Spec 34 — AI assist (optional). Default / incomplete = Assist UI hidden.
# Prefer non-Google :free models on OpenRouter — Google free SKUs often 429
# without your own Google AI Studio key linked in OpenRouter integrations.
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=cohere/north-mini-code:free
# AI_TIMEOUT_MS=60000
